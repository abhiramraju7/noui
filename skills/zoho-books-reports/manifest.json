{
  "schema_version": "1",
  "skill_id": "zoho-books-reports",
  "app": {
    "name": "Zoho Books Reports",
    "slug": "zoho-books-reports"
  },
  "workflow": {
    "id": "zoho-books-reports",
    "name": "Reports",
    "start_url": "https://books.zoho.in"
  },
  "auth": {
    "requires_auth": true,
    "profile_slug": "zoho-books",
    "profile_db_id": "ac128c7c-d0d5-45d0-99e3-079c4ec32a86",
    "strategy": "tabby_execute"
  },
  "runtime": {
    "type": "claude-code-skill",
    "entrypoint": "SKILL.md",
    "operation_style": "subprocess-cli",
    "transport": "execute",
    "python": ">=3.11",
    "python_executable": ".venv/bin/python"
  },
  "operations": [
    {
      "name": "profit_and_loss",
      "description": "Profit & Loss report for a date range: income, cost of goods sold, gross/operating profit, and expenses as a flattened list of rows with totals.",
      "module": "operations/profit_and_loss.py",
      "entry": "execute",
      "method": "GET",
      "path": "/api/v3/reports/profitandloss",
      "args": [
        {"name": "from_date", "type": "string", "required": true},
        {"name": "to_date", "type": "string", "required": false}
      ]
    },
    {
      "name": "balance_sheet",
      "description": "Balance Sheet report as of a date: assets, liabilities, and equity as a flattened list of rows with totals.",
      "module": "operations/balance_sheet.py",
      "entry": "execute",
      "method": "GET",
      "path": "/api/v3/reports/balancesheet",
      "args": [
        {"name": "to_date", "type": "string", "required": false},
        {"name": "from_date", "type": "string", "required": false}
      ]
    }
  ]
}
